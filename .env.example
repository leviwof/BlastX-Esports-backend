SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
ADMIN_LOGIN_EMAIL="admin@example.com"
ADMIN_LOGIN_PASSWORD="your-admin-password-here"
FIREBASE_SERVICE_ACCOUNT_JSON="{}"

# Storage options (Supabase or Google Drive)
