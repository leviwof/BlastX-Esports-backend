NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/blastix_db"
DIRECT_URL="postgresql://user:password@localhost:5432/blastix_db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN="30d"
OTP_PEPPER="your-otp-pepper-here"
