generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OwnerRole {
  LEADER
  MANAGER
}

enum TeamMemberRole {
  CAPTAIN
  MANAGER
  PLAYER
  SUBSTITUTE
}

enum SquadRole {
  LEADER
  MANAGER
  MEMBER
}

enum SquadRosterType {
  MAIN
  SUBSTITUTE
}

enum TournamentInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TournamentFormat {
  BATTLE_ROYALE
  CLASH_SQUAD
}

enum TeamMode {
  SOLO
  DUO
  SQUAD
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentSection {
  FREEFIRE_LIVE
  BLASTX
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  DISQUALIFIED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?   @db.Text
  profilePic         String?   @map("profile_pic")
  googleId           String?   @unique @map("google_id")
  role               UserRole  @default(USER)
  isActive           Boolean   @default(true) @map("is_active")
  isVip              Boolean   @default(false) @map("is_vip")
  crownBadgeUnlocked Boolean   @default(false) @map("crown_badge_unlocked")
  xp                 Int       @default(0)
  rank               Int       @default(1)
  fcmToken           String?   @map("fcm_token") @db.Text
  fcmUpdatedAt       DateTime? @map("fcm_updated_at") @db.Timestamp(3)
  deviceType         String?   @map("device_type")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  gameProfiles              GameProfile[]
  captainTeams              Team[]                   @relation("CaptainTeams")
  teamMemberships           TeamMember[]
  squadMemberships          SquadMember[]
  ledSquads                 Squad[]                  @relation("SquadLeader")
  sentTournamentInvites     TournamentInvitation[]   @relation("InvitationLeader")
  receivedTournamentInvites TournamentInvitation[]   @relation("InvitationInvitee")
  createdTournaments        Tournament[]             @relation("CreatedTournaments")
  tournamentRegistrations   TournamentRegistration[]
  userChallenges            UserChallenge[]

  @@index([fcmToken], map: "users_fcm_token_idx")
  @@map("users")
}

model AppConfig {
  id                 Int     @id @default(1)
  minVersion         String  @map("min_version")
  latestVersion      String  @map("latest_version")
  isMaintenance      Boolean @default(false) @map("is_maintenance")
  maintenanceMessage String  @map("maintenance_message")
  updateUrl          String  @map("update_url")

  @@map("app_config")
}

model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  gameProfiles GameProfile[]
  teams        Team[]
  tournaments  Tournament[]
  squads       Squad[]

  @@map("games")
}

model GameProfile {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  gameId     String   @map("game_id")
  inGameUid  String   @map("in_game_uid")
  inGameName String   @map("in_game_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId], name: "unique_user_game")
  @@unique([gameId, inGameUid], name: "unique_game_uid")
  @@map("game_profiles")
}

model Team {
  id                   String    @id @default(cuid())
  gameId               String    @map("game_id")
  tournamentId         String?   @map("tournament_id")
  persistentSquadId    String?   @map("persistent_squad_id")
  name                 String
  tag                  String
  logoUrl              String?   @map("logo_url")
  captainId            String    @map("captain_id")
  ownerRole            OwnerRole @default(LEADER) @map("owner_role")
  inviteCode           String    @unique @map("invite_code")
  acceptingSubstitutes Boolean   @default(true) @map("accepting_substitutes")
  createdAt            DateTime  @default(now()) @map("created_at")

  game                  Game                     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tournament            Tournament?              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  persistentSquad       Squad?                   @relation(fields: [persistentSquadId], references: [id], onDelete: SetNull)
  captain               User                     @relation("CaptainTeams", fields: [captainId], references: [id], onDelete: Restrict)
  members               TeamMember[]
  registrations         TournamentRegistration[]
  tournamentInvitations TournamentInvitation[]

  @@unique([gameId, tournamentId, name], name: "unique_game_tournament_team_name")
  @@unique([tournamentId, persistentSquadId], name: "unique_tournament_persistent_squad")
  @@index([tournamentId])
  @@index([persistentSquadId])
  @@index([captainId])
  @@index([gameId])
  @@map("teams")
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String         @map("team_id")
  userId   String         @map("user_id")
  role     TeamMemberRole @default(PLAYER)
  joinedAt DateTime       @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "unique_team_user")
  @@index([userId])
  @@map("team_members")
}

model Tournament {
  id                   String            @id @default(cuid())
  gameId               String            @map("game_id")
  title                String
  description          String?
  bannerUrl            String?           @map("banner_url")
  format               TournamentFormat
  teamMode             TeamMode          @map("team_mode")
  map                  String
  maxSlots             Int               @map("max_slots")
  registeredCount      Int               @default(0) @map("registered_count")
  entryFee             Int               @default(0) @map("entry_fee")
  prizePool            Int               @default(0) @map("prize_pool")
  prizeDistribution    Json?             @map("prize_distribution")
  rules                Json?
  registrationOpensAt  DateTime          @map("registration_opens_at")
  registrationClosesAt DateTime          @map("registration_closes_at")
  startsAt             DateTime          @map("starts_at")
  status               TournamentStatus  @default(DRAFT)
  section              TournamentSection @default(BLASTX)
  streamUrl            String?           @map("stream_url")
  viewersCount         Int               @default(0) @map("viewers_count")
  organizerName        String?           @map("organizer_name")
  organizerVerified    Boolean           @default(false) @map("organizer_verified")
  accentColorHex       String?           @map("accent_color_hex")
  perKillReward        Int               @default(0) @map("per_kill_reward")
  booyahBonus          Int               @default(0) @map("booyah_bonus")
  pointsSystem         Json?             @map("points_system")
  schedule             Json?
  announcements        Json?
  roomId               String?           @map("room_id")
  roomPassword         String?           @map("room_password")
  roomReleasedAt       DateTime?         @map("room_released_at")
  createdBy            String            @map("created_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  game                  Game                     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  creator               User                     @relation("CreatedTournaments", fields: [createdBy], references: [id], onDelete: Restrict)
  teams                 Team[]
  registrations         TournamentRegistration[]
  matches               Match[]
  tournamentInvitations TournamentInvitation[]

  @@index([gameId, status, startsAt])
  @@index([section, status, startsAt])
  @@map("tournaments")
}

model Squad {
  id             String    @id @default(cuid())
  gameId         String    @map("game_id")
  name           String    @db.VarChar(50)
  tag            String    @default("") @db.VarChar(10)
  logoUrl        String?   @map("logo_url") @db.VarChar(255)
  leaderId       String    @map("leader_id")
  ownerRole      OwnerRole @default(LEADER) @map("owner_role")
  maxMainPlayers Int       @default(4) @map("max_main_players")
  maxSubstitutes Int       @default(2) @map("max_substitutes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  game        Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  leader      User                   @relation("SquadLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members     SquadMember[]
  teams       Team[]
  invitations TournamentInvitation[]

  @@unique([gameId, leaderId], map: "squads_game_leader_key")
  @@index([leaderId])
  @@map("squads")
}

model SquadMember {
  id         String          @id @default(cuid())
  squadId    String          @map("squad_id")
  userId     String          @unique(map: "squad_members_user_id_key") @map("user_id")
  role       SquadRole       @default(MEMBER)
  rosterType SquadRosterType @default(MAIN) @map("roster_type")
  joinedAt   DateTime        @default(now()) @map("joined_at")

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId], map: "squad_members_squad_user_key")
  @@index([squadId, rosterType])
  @@map("squad_members")
}

model TournamentInvitation {
  id            String                     @id @default(cuid())
  squadId       String                     @map("squad_id")
  tournamentId  String                     @map("tournament_id")
  teamId        String                     @map("team_id")
  leaderId      String                     @map("leader_id")
  inviteeUserId String                     @map("invitee_user_id")
  status        TournamentInvitationStatus @default(PENDING)
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  squad      Squad      @relation(fields: [squadId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leader     User       @relation("InvitationLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  invitee    User       @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([squadId, tournamentId, inviteeUserId], map: "tournament_invites_squad_tournament_user_key")
  @@index([inviteeUserId, status, createdAt])
  @@index([tournamentId, status])
  @@map("tournament_invitations")
}

model TournamentRegistration {
  id           String             @id @default(cuid())
  tournamentId String             @map("tournament_id")
  userId       String             @map("user_id")
  teamId       String?            @map("team_id")
  status       RegistrationStatus @default(CONFIRMED)
  slotNumber   Int                @map("slot_number")
  finalRank    Int?               @map("final_rank")
  createdAt    DateTime           @default(now()) @map("created_at")

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matchResults MatchResult[]

  @@unique([tournamentId, userId], name: "unique_tournament_user")
  @@unique([tournamentId, teamId], name: "unique_tournament_team")
  @@index([userId])
  @@index([teamId])
  @@map("tournament_registrations")
}

model Match {
  id             String      @id @default(cuid())
  tournamentId   String      @map("tournament_id")
  matchNumber    Int         @map("match_number")
  round          String      @default("Round 1") @map("round")
  map            String
  status         MatchStatus @default(SCHEDULED)
  scheduledAt    DateTime    @map("scheduled_at")
  reminderSentAt DateTime?   @map("reminder_sent_at") @db.Timestamp(3)
  endedAt        DateTime?   @map("ended_at")
  streamUrl      String?     @map("stream_url")
  winnerTeamName String?     @map("winner_team_name")
  topKillerName  String?     @map("top_killer_name")
  createdAt      DateTime    @default(now()) @map("created_at")

  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  results    MatchResult[]

  @@unique([tournamentId, matchNumber], name: "unique_tournament_match_number")
  @@index([tournamentId])
  @@index([status, scheduledAt, reminderSentAt], map: "matches_scheduled_reminder_idx")
  @@map("matches")
}

model MatchResult {
  id              String   @id @default(cuid())
  matchId         String   @map("match_id")
  registrationId  String   @map("registration_id")
  placement       Int
  kills           Int      @default(0)
  placementPoints Int      @default(0) @map("placement_points")
  killPoints      Int      @default(0) @map("kill_points")
  totalPoints     Int      @default(0) @map("total_points")
  createdAt       DateTime @default(now()) @map("created_at")

  match        Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registration TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([matchId, registrationId], name: "unique_match_registration")
  @@index([registrationId])
  @@map("match_results")
}

enum ChallengeType {
  DAILY
  WEEKLY
  SPECIAL
}

enum ChallengeStatus {
  ACTIVE
  PROOF_SUBMITTED
  PROOF_REJECTED
  COMPLETED
  CLAIMED
}

model Challenge {
  id                String        @id @default(cuid())
  title             String
  description       String
  rewardXp          Int           @map("reward_xp")
  targetProgress    Float         @default(1.0) @map("target_progress")
  game              String        @default("Free Fire")
  type              ChallengeType @default(DAILY)
  requiresRecording Boolean       @default(true) @map("requires_recording")
  gamePackage       String        @default("com.dts.freefireth") @map("game_package")
  iconAsset         String?       @map("icon_asset")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")

  userProgress UserChallenge[]

  @@map("challenges")
}

model UserChallenge {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  challengeId     String          @map("challenge_id")
  currentProgress Float           @default(0.0) @map("current_progress")
  status          ChallengeStatus @default(ACTIVE)
  isCompleted     Boolean         @default(false) @map("is_completed")
  isClaimed       Boolean         @default(false) @map("is_claimed")
  proofUrl        String?         @map("proof_url")
  rejectionReason String?         @map("rejection_reason")
  reviewedAt      DateTime?       @map("reviewed_at")
  reviewedBy      String?         @map("reviewed_by")
  submittedAt     DateTime?       @map("submitted_at")
  claimedAt       DateTime?       @map("claimed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId], name: "unique_user_challenge")
  @@map("user_challenges")
}

enum NoticeSeverity {
  INFO
  WARNING
  CRITICAL
}

model Banner {
  id             String    @id @default(cuid())
  tagline        String?
  title          String
  subtitle       String?
  brandBadge     String?   @map("brand_badge")
  imageUrl       String    @map("image_url")
  buttonText     String?   @map("button_text")
  targetTabIndex Int       @default(1) @map("target_tab_index")
  linkUrl        String?   @map("link_url")
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model LiveStream {
  id          String   @id @default(cuid())
  title       String
  subtitle    String
  location    String
  viewerCount String   @default("0") @map("viewer_count")
  isLive      Boolean  @default(false) @map("is_live")
  isOfficial  Boolean  @default(false) @map("is_official")
  imageUrl    String   @map("image_url")
  streamUrl   String   @map("stream_url")
  ctaText     String   @default("Watch Now →") @map("cta_text")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("live_streams")
}

model BrandPartner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String   @map("logo_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("brand_partners")
}

model PartnerInquiry {
  id              String   @id @default(cuid())
  brandName       String   @map("brand_name")
  contactName     String   @map("contact_name")
  email           String
  phone           String
  partnershipType String   @map("partnership_type")
  message         String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("partner_inquiries")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Notice {
  id        String         @id @default(cuid())
  title     String
  body      String
  severity  NoticeSeverity @default(INFO)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("notices")
}
